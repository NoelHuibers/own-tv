{
  "name": "own-tv",
  "version": "0.2.4",
  "private": true,
  "description": "A private, personal dashboard for rooted LG webOS TVs",
  "license": "MIT",
  "scripts": {
    "lint": "biome ci --error-on-warnings .",
    "test": "pnpm test:node && pnpm test:python",
    "test:node": "node --test tests/*.test.cjs",
    "test:python": "python3 -m unittest discover -s tests -p \"*.py\"",
    "test:e2e": "playwright test",
    "coverage": "node scripts/coverage.mjs",
    "check": "pnpm lint && pnpm test && pnpm test:e2e",
    "preview": "python3 -m http.server 5173 --bind 127.0.0.1 --directory app",
    "package": "python3 tools/package.py",
    "format": "biome check --write ."
  },
  "dependencies": {
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": "^20.12.2"
  },
  "packageManager": "pnpm@12.14.0"
}
